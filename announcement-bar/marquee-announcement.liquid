          "label": "Circle ○"
        },
        {
          "value": "slash",
          "label": "Slash /"
        },
        {
          "value": "plus",
          "label": "Plus +"
        },
        {
          "value": "sparkle",
          "label": "Sparkle ✦"
        }
      ],
      "default": "line"
    },
    {
      "type": "range",
      "id": "separator_size",
      "label": "Separator size",
      "min": 8,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "separator_gap",
      "label": "Separator spacing",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },

    {
      "type": "header",
      "content": "Edge fade"
    },
    {
      "type": "checkbox",
      "id": "enable_fade",
      "label": "Enable edge fade",
      "default": true
