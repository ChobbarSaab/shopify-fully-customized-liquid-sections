{% assign marquee_font = section.settings.font_family %}

<div
  id="CustomMarquee-{{ section.id }}"
  class="custom-marquee"
  style="
    --marquee-bg: {{ section.settings.background_color }};
    --marquee-text: {{ section.settings.text_color }};
    --marquee-separator: {{ section.settings.separator_color }};
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-height: {{ section.settings.height }}px;
    --marquee-mobile-height: {{ section.settings.mobile_height }}px;
    --marquee-font-size: {{ section.settings.font_size }}px;
    --marquee-mobile-font-size: {{ section.settings.mobile_font_size }}px;
    --marquee-letter-spacing: {{ section.settings.letter_spacing }}px;
    --marquee-mobile-letter-spacing: {{ section.settings.mobile_letter_spacing }}px;
    --marquee-gap: {{ section.settings.gap }}px;
    --marquee-mobile-gap: {{ section.settings.mobile_gap }}px;
    --marquee-font-weight: {{ section.settings.font_weight }};
    --marquee-line-height: {{ section.settings.line_height }};
    --marquee-separator-size: {{ section.settings.separator_size }}px;
    --marquee-separator-gap: {{ section.settings.separator_gap }}px;
    --marquee-fade-width: {{ section.settings.fade_width }}px;
  "
>
  {{ marquee_font | font_face }}

  <div class="custom-marquee__viewport">

    {% if section.settings.enable_fade %}
      <div class="custom-marquee__fade custom-marquee__fade--left"></div>
      <div class="custom-marquee__fade custom-marquee__fade--right"></div>
    {% endif %}

    <div
      class="
        custom-marquee__track
        {% if section.settings.pause_on_hover %}
          custom-marquee__track--pause
        {% endif %}
      "
      data-direction="{{ section.settings.direction }}"
    >

      <div class="custom-marquee__group">

        {% for block in section.blocks %}

          <div
            class="custom-marquee__item"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="custom-marquee__link"
              >
            {% endif %}

            <span class="custom-marquee__text">
              {{ block.settings.text | escape }}
            </span>

            {% if section.settings.show_separator %}
              <span
                class="custom-marquee__separator"
                aria-hidden="true"
              >
                {% case section.settings.separator_style %}

                  {% when 'line' %}
                    |

                  {% when 'dot' %}
                    •

                  {% when 'diamond' %}
                    ◆

                  {% when 'star' %}
                    ★

                  {% when 'arrow' %}
                    →

                  {% when 'circle' %}
                    ○

                  {% when 'slash' %}
                    /

                  {% when 'plus' %}
                    +

                  {% when 'sparkle' %}
                    ✦

                {% endcase %}
              </span>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}

          </div>

        {% endfor %}

      </div>

    </div>

  </div>
</div>

<style>
  #CustomMarquee-{{ section.id }} {
    width: 100%;
    height: var(--marquee-height);
    overflow: hidden;
    display: flex;
    align-items: center;

    position: relative;

    background: var(--marquee-bg);
    color: var(--marquee-text);
  }

  #CustomMarquee-{{ section.id }} .custom-marquee__viewport {
    width: 100%;
    height: 100%;

    overflow: hidden;

    position: relative;

    display: flex;
    align-items: center;
  }

  #CustomMarquee-{{ section.id }} .custom-marquee__track {
    display: flex;
    width: max-content;
    flex-shrink: 0;

    will-change: transform;
  }

  #CustomMarquee-{{ section.id }} .custom-marquee__group {
    display: flex;
    align-items: center;

    flex-shrink: 0;

    font-family: {{ marquee_font.family }}, {{ marquee_font.fallback_families }};
    font-size: var(--marquee-font-size);
    font-weight: var(--marquee-font-weight);
    line-height: var(--marquee-line-height);
    letter-spacing: var(--marquee-letter-spacing);

    {% if marquee_font.style == 'italic' %}
      font-style: italic;
    {% else %}
      font-style: normal;
    {% endif %}

    {% case section.settings.text_transform %}
      {% when 'uppercase' %}
        text-transform: uppercase;
      {% when 'lowercase' %}
        text-transform: lowercase;
      {% when 'capitalize' %}
        text-transform: capitalize;
      {% else %}
        text-transform: none;
    {% endcase %}

    {% if section.settings.text_decoration == 'underline' %}
      text-decoration: underline;
      text-underline-offset: 3px;
    {% else %}
      text-decoration: none;
    {% endif %}
  }

  #CustomMarquee-{{ section.id }} .custom-marquee__item {
    display: flex;
    align-items: center;

    flex-shrink: 0;
    white-space: nowrap;
  }

  #CustomMarquee-{{ section.id }} .custom-marquee__link {
    display: flex;
    align-items: center;

    color: inherit;
    text-decoration: inherit;
  }

  #CustomMarquee-{{ section.id }} .custom-marquee__text {
    display: inline-block;

    margin-left: var(--marquee-gap);

    white-space: nowrap;
  }

  #CustomMarquee-{{ section.id }} .custom-marquee__separator {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-left: var(--marquee-separator-gap);

    color: var(--marquee-separator);

    font-size: var(--marquee-separator-size);

    line-height: 1;

    flex-shrink: 0;
  }

  #CustomMarquee-{{ section.id }} .custom-marquee__track--pause:hover {
    animation-play-state: paused !important;
  }

  {% if section.settings.enable_fade %}

    #CustomMarquee-{{ section.id }} .custom-marquee__fade {
      position: absolute;
      top: 0;
      bottom: 0;

      width: var(--marquee-fade-width);

      z-index: 5;

      pointer-events: none;
    }

    #CustomMarquee-{{ section.id }} .custom-marquee__fade--left {
      left: 0;

      background: linear-gradient(
        to right,
        var(--marquee-bg),
        transparent
      );
    }

    #CustomMarquee-{{ section.id }} .custom-marquee__fade--right {
      right: 0;

      background: linear-gradient(
        to left,
        var(--marquee-bg),
        transparent
      );
    }

  {% endif %}

  @media screen and (max-width: 749px) {

    #CustomMarquee-{{ section.id }} {
      height: var(--marquee-mobile-height);
    }

    #CustomMarquee-{{ section.id }} .custom-marquee__group {
      font-size: var(--marquee-mobile-font-size);
      letter-spacing: var(--marquee-mobile-letter-spacing);
    }

    #CustomMarquee-{{ section.id }} .custom-marquee__text {
      margin-left: var(--marquee-mobile-gap);
    }

    #CustomMarquee-{{ section.id }} .custom-marquee__separator {
      margin-left: var(--marquee-mobile-gap);
    }

  }

  @media (prefers-reduced-motion: reduce) {

    #CustomMarquee-{{ section.id }} .custom-marquee__track {
      animation: none !important;
      transform: translateX(0) !important;
    }

  }
</style>

<script>
  (function () {

    function initCustomMarquee() {

      var marquee = document.getElementById(
        'CustomMarquee-{{ section.id }}'
      );

      if (!marquee) return;

      var viewport = marquee.querySelector(
        '.custom-marquee__viewport'
      );

      var track = marquee.querySelector(
        '.custom-marquee__track'
      );

      var originalGroup = marquee.querySelector(
        '.custom-marquee__group'
      );

      if (!viewport || !track || !originalGroup) return;

      var direction = track.dataset.direction;

      var speed = {{ section.settings.speed | json }};

      function buildMarquee() {

        track.style.animation = 'none';
        track.style.transform = 'translateX(0)';

        track.innerHTML = '';

        var baseGroup = originalGroup.cloneNode(true);

        track.appendChild(baseGroup);

        var groupWidth =
          baseGroup.getBoundingClientRect().width;

        var viewportWidth =
          viewport.getBoundingClientRect().width;

        if (!groupWidth || !viewportWidth) return;

        var requiredWidth =
          viewportWidth + groupWidth;

        while (track.scrollWidth < requiredWidth) {

          track.appendChild(
            baseGroup.cloneNode(true)
          );

        }

        var cycleWidth =
          baseGroup.getBoundingClientRect().width;

        var animationName =
          'custom-marquee-scroll-{{ section.id }}';

        var styleId =
          'custom-marquee-keyframes-{{ section.id }}';

        var oldStyle =
          document.getElementById(styleId);

        if (oldStyle) {
          oldStyle.remove();
        }

        var style =
          document.createElement('style');

        style.id = styleId;

        if (direction === 'left') {

          style.textContent =
            '@keyframes ' +
            animationName +
            ' {' +
            'from {' +
            'transform: translate3d(0,0,0);' +
            '}' +
            'to {' +
            'transform: translate3d(-' +
            cycleWidth +
            'px,0,0);' +
            '}' +
            '}';

        } else {

          style.textContent =
            '@keyframes ' +
            animationName +
            ' {' +
            'from {' +
            'transform: translate3d(-' +
            cycleWidth +
            'px,0,0);' +
            '}' +
            'to {' +
            'transform: translate3d(0,0,0);' +
            '}' +
            '}';

        }

        document.head.appendChild(style);

        track.style.animation =
          animationName +
          ' ' +
          speed +
          's linear infinite';

        if (direction === 'right') {

          track.style.transform =
            'translate3d(-' +
            cycleWidth +
            'px,0,0)';

        } else {

          track.style.transform =
            'translate3d(0,0,0)';

        }

      }

      buildMarquee();

      var resizeTimer;

      window.addEventListener(
        'resize',
        function () {

          clearTimeout(resizeTimer);

          resizeTimer =
            setTimeout(
              buildMarquee,
              150
            );

        },
        { passive: true }
      );

    }

    if (
      document.readyState === 'loading'
    ) {

      document.addEventListener(
        'DOMContentLoaded',
        initCustomMarquee
      );

    } else {

      initCustomMarquee();

    }

  })();
</script>

{% schema %}
{
  "name": "Custom Marquee",
  "max_blocks": 20,
  "settings": [

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scrolling speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        {
          "value": "left",
          "label": "Right to left"
        },
        {
          "value": "right",
          "label": "Left to right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Font",
      "default": "roboto_n4"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "text_decoration",
      "label": "Text decoration",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
