{%- comment -%}
  ============================================================
  TESTIMONIALS — fully customizable Shopify OS 2.0 section
  ------------------------------------------------------------
  • 4 layouts: Grid, Carousel, Masonry, Scrolling "wall of love"
  • 5 card styles: Solid, Glass, Gradient border, Outline, Minimal
  • Star ratings, review title, customer photo or auto initials
  • "Verified buyer" badge, purchased product link, review photo
  • Rating summary in the heading (e.g. 4.9 ★ from 2,000+ reviews)
  • Carousel: arrows, dots, autoplay, swipe, loop
  • Marquee: 1 or 2 rows, opposite directions, pause on hover
  • Read more for long reviews, cursor spotlight, hover effects
  • Reduced-motion support, no external libraries
  ============================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign heading_font = s.heading_font
  assign body_font = s.body_font
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'

  assign section_bg = s.background_color
  if s.background_gradient != blank
    assign section_bg = s.background_gradient
  endif

  assign card_alpha = s.card_opacity | divided_by: 100.0
  assign card_bg = s.card_bg | color_modify: 'alpha', card_alpha

  assign spot_alpha = s.spotlight_strength | divided_by: 100.0
  assign spot_color = s.spotlight_color | color_modify: 'alpha', spot_alpha

  assign effect_alpha = s.effect_strength | divided_by: 100.0
  assign effect_color = s.effect_color | color_modify: 'alpha', effect_alpha

  assign block_count = section.blocks.size

  assign show_header = false
  if s.eyebrow != blank or s.heading != blank or s.subheading != blank or s.show_summary
    assign show_header = true
  endif

  assign two_rows = false
  if s.layout == 'marquee' and s.marquee_rows == '2' and block_count > 1
    assign two_rows = true
  endif

  assign star_path = 'M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z'
-%}

{%- comment -%} Build every card once, then place it in the chosen layout. {%- endcomment -%}
{%- capture cards_all -%}{%- endcapture -%}
{%- capture row_one -%}{%- endcapture -%}
{%- capture row_two -%}{%- endcapture -%}
{%- assign row_one_count = 0 -%}
{%- assign row_two_count = 0 -%}

{%- for block in section.blocks -%}
  {%- liquid
    assign b = block.settings
    assign rating = b.rating
    assign name_parts = b.name | strip | split: ' '
    assign initials = ''
    if name_parts.size > 0
      assign initials = name_parts.first | slice: 0
      if name_parts.size > 1
        assign last_initial = name_parts.last | slice: 0
        assign initials = initials | append: last_initial
      endif
      assign initials = initials | upcase
    endif
  -%}

  {%- capture author_html -%}
    {%- if b.name != blank or b.role != blank -%}
      <div class="ts__author">
        {%- if s.show_avatar -%}
          {%- if b.image != blank -%}
            {{
              b.image
              | image_url: width: 200
              | image_tag: class: 'ts__avatar', loading: 'lazy', width: 100, height: 100, alt: b.name
            }}
          {%- elsif s.show_initials and initials != '' -%}
            <span class="ts__avatar ts__avatar--initials" aria-hidden="true">{{ initials | escape }}</span>
          {%- endif -%}
        {%- endif -%}

        <div class="ts__author-text">
          {%- if b.name != blank -%}
            <p class="ts__name">
              {{- b.name | escape -}}
              {%- if b.verified and s.verified_style == 'icon' -%}
                <svg class="ts__verified-icon" viewBox="0 0 24 24" aria-label="{{ s.verified_text | escape }}" role="img" focusable="false"><path fill="currentColor" d="M12 1.5 14.6 3.4l3.2-.1 1 3 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3-3.2-.1L12 22.5l-2.6-1.9-3.2.1-1-3-2.6-1.9 1-3.1-1-3.1 2.6-1.9 1-3 3.2.1z"/><path d="m8.5 12.2 2.3 2.3 4.7-4.8" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if b.role != blank or b.date != blank or b.verified and s.verified_style == 'text' -%}
            <p class="ts__meta">
              {%- if b.verified and s.verified_style == 'text' -%}
                <span class="ts__verified">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg>
                  {{- s.verified_text | escape -}}
                </span>
              {%- endif -%}
              {%- if b.role != blank -%}<span>{{ b.role | escape }}</span>{%- endif -%}
              {%- if b.date != blank -%}<span>{{ b.date | escape }}</span>{%- endif -%}
            </p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture card -%}
    <div class="ts__item" role="listitem" style="--ts-i: {{ forloop.index }};" {{ block.shopify_attributes }}>
      <div class="ts__card">
        {%- if s.show_quote_icon -%}
          <svg class="ts__quote-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9.6 5C5.9 6.3 3.5 9.4 3.5 13.5v5.2c0 .4.3.8.8.8h5.2c.4 0 .8-.3.8-.8v-5.2c0-.4-.3-.8-.8-.8H6.8c0-2.6 1.3-4.6 3.6-5.6.3-.1.5-.5.4-.8l-.3-.9c-.2-.4-.6-.6-.9-.4zm10 0c-3.7 1.3-6.1 4.4-6.1 8.5v5.2c0 .4.3.8.8.8h5.2c.4 0 .8-.3.8-.8v-5.2c0-.4-.3-.8-.8-.8h-2.7c0-2.6 1.3-4.6 3.6-5.6.3-.1.5-.5.4-.8l-.3-.9c-.2-.4-.6-.6-.9-.4z"/></svg>
        {%- endif -%}

        {%- if s.author_position == 'top' -%}{{ author_html }}{%- endif -%}

        {%- if s.show_rating and rating > 0 -%}
          <div class="ts__stars" role="img" aria-label="{{ rating }} / 5">
            {%- for i in (1..5) -%}
              <svg class="ts__star{% if i > rating %} is-empty{% endif %}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ star_path }}"/></svg>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if b.title != blank -%}
          <p class="ts__title">{{ b.title | escape }}</p>
        {%- endif -%}

        {%- if b.quote != blank -%}
          <blockquote class="ts__quote">
            <p class="ts__quote-text">{{ b.quote | escape | newline_to_br }}</p>
          </blockquote>
          {%- if s.line_clamp > 0 -%}
            <button type="button" class="ts__more" hidden aria-expanded="false">{{ s.read_more_text | escape }}</button>
          {%- endif -%}
        {%- endif -%}

        {%- if b.review_image != blank and s.show_review_images -%}
          {{
            b.review_image
            | image_url: width: 800
            | image_tag: class: 'ts__photo', loading: 'lazy', sizes: '(min-width: 990px) 400px, 90vw', widths: '300, 500, 800', alt: b.review_image.alt
          }}
        {%- endif -%}

        {%- if b.product != blank and s.show_product -%}
          <a href="{{ b.product.url }}" class="ts__product">
            {%- if b.product.featured_image -%}
              {{
                b.product.featured_image
                | image_url: width: 120
                | image_tag: class: 'ts__product-img', loading: 'lazy', width: 60, height: 60, alt: ''
              }}
            {%- endif -%}
            <span class="ts__product-text">
              {%- if s.product_label != blank -%}<span class="ts__product-label">{{ s.product_label | escape }}</span>{%- endif -%}
              <span class="ts__product-title">{{ b.product.title | escape }}</span>
            </span>
          </a>
        {%- endif -%}

        {%- if s.author_position == 'bottom' -%}{{ author_html }}{%- endif -%}
      </div>
    </div>
  {%- endcapture -%}

  {%- liquid
    assign cards_all = cards_all | append: card
    assign row_index = forloop.index | modulo: 2
    if two_rows and row_index == 0
      assign row_two = row_two | append: card
      assign row_two_count = row_two_count | plus: 1
    else
      assign row_one = row_one | append: card
      assign row_one_count = row_one_count | plus: 1
    endif
  -%}
{%- endfor -%}

{%- liquid
  comment
    Marquee: repeat each row enough times to always cover wide screens.
  endcomment
  assign card_span = s.marquee_card_width | plus: s.gap
  assign row_one_width = row_one_count | times: card_span
  assign row_two_width = row_two_count | times: card_span
  assign copies_one = 2
  assign copies_two = 2
  if row_one_width > 0
    assign copies_one = 2560 | divided_by: row_one_width | plus: 2
  endif
  if row_two_width > 0
    assign copies_two = 2560 | divided_by: row_two_width | plus: 2
  endif
  if copies_one > 12
    assign copies_one = 12
  endif
  if copies_two > 12
    assign copies_two = 12
  endif
-%}

<section
  id="Testimonials-{{ section.id }}"
  class="
    ts
    ts--layout-{{ s.layout }}
    ts--style-{{ s.card_style }}
    ts--align-{{ s.card_align }}
    ts--shadow-{{ s.card_shadow }}
    ts--hover-{{ s.hover_effect }}
    ts--quote-{{ s.quote_icon_position }}
    ts--avatar-{{ s.avatar_shape }}
    ts--entrance-{{ s.entrance_animation }}
    ts--highlight-{{ s.heading_highlight }}
    ts--arrows-{{ s.arrows_position }}
    {% if s.enable_spotlight %}ts--spotlight{% endif %}
    {% if s.animate_border %}ts--spin{% endif %}
    {% if s.marquee_pause %}ts--pause{% endif %}
    {% if s.marquee_fade %}ts--fade{% endif %}
    {% if s.full_width %}ts--full{% endif %}
  "
  data-layout="{{ s.layout }}"
  data-entrance="{{ s.entrance_animation }}"
  data-autoplay="{% if s.autoplay %}{{ s.autoplay_speed }}{% else %}0{% endif %}"
  data-loop="{{ s.carousel_loop }}"
  data-more="{{ s.read_more_text | escape }}"
  data-less="{{ s.read_less_text | escape }}"
  {% if s.heading != blank %}aria-label="{{ s.heading | strip_html | escape }}"{% endif %}
>
  {%- if s.background_effect != 'none' -%}
    <div class="ts__bg ts__bg--{{ s.background_effect }}" aria-hidden="true"></div>
  {%- endif -%}

  <div class="ts__inner">
    {%- if show_header -%}
      <div class="ts__header ts__reveal">
        {%- if s.eyebrow != blank -%}
          <p class="ts__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <{{ s.heading_tag }} class="ts__heading">{{ s.heading }}</{{ s.heading_tag }}>
        {%- endif -%}

        {%- if s.subheading != blank -%}
          <p class="ts__subheading">{{ s.subheading }}</p>
        {%- endif -%}

        {%- if s.show_summary -%}
          <div class="ts__summary">
            {%- if s.summary_rating != blank -%}
              <span class="ts__summary-score">{{ s.summary_rating | escape }}</span>
            {%- endif -%}
            <span class="ts__stars ts__stars--summary" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg class="ts__star" viewBox="0 0 24 24" focusable="false"><path d="{{ star_path }}"/></svg>
              {%- endfor -%}
            </span>
            {%- if s.summary_text != blank -%}
              <span class="ts__summary-text">{{ s.summary_text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if block_count > 0 -%}
      {%- case s.layout -%}
        {%- when 'carousel' -%}
          <div class="ts__carousel ts__reveal">
            <div class="ts__track" role="list" tabindex="0" aria-label="{{ s.heading | default: 'Testimonials' | strip_html | escape }}">
              {{ cards_all }}
            </div>

            {%- if s.arrows_position != 'none' or s.show_dots -%}
              <div class="ts__nav">
                {%- if s.arrows_position != 'none' -%}
                  <button type="button" class="ts__arrow ts__arrow--prev" aria-label="{{ s.prev_label | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
                  </button>
                {%- endif -%}
                {%- if s.show_dots -%}
                  <div class="ts__dots"></div>
                {%- endif -%}
                {%- if s.arrows_position != 'none' -%}
                  <button type="button" class="ts__arrow ts__arrow--next" aria-label="{{ s.next_label | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

        {%- when 'marquee' -%}
          <div class="ts__marquee ts__reveal">
            <div class="ts__marquee-row" role="list">
              <div class="ts__marquee-track" style="--ts-shift: calc(-100% / {{ copies_one }});">
                {%- for i in (1..copies_one) -%}
                  <div class="ts__marquee-set"{% unless forloop.first %} aria-hidden="true" inert{% endunless %}>{{ row_one }}</div>
                {%- endfor -%}
              </div>
            </div>

            {%- if two_rows -%}
              <div class="ts__marquee-row ts__marquee-row--reverse" role="list">
                <div class="ts__marquee-track" style="--ts-shift: calc(-100% / {{ copies_two }});">
                  {%- for i in (1..copies_two) -%}
                    <div class="ts__marquee-set"{% unless forloop.first %} aria-hidden="true" inert{% endunless %}>{{ row_two }}</div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>

        {%- else -%}
          <div class="ts__list ts__reveal" role="list">
            {{ cards_all }}
          </div>
      {%- endcase -%}
    {%- endif -%}
  </div>
</section>

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {% if heading_font_bold %}{{ heading_font_bold | font_face: font_display: 'swap' }}{% endif %}
  {{ body_font | font_face: font_display: 'swap' }}
  {% if body_font_bold %}{{ body_font_bold | font_face: font_display: 'swap' }}{% endif %}

  @property --ts-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  /* ---------- Settings → CSS variables ---------- */
  #Testimonials-{{ section.id }} {
    --ts-bg: {{ section_bg }};
    --ts-eyebrow: {{ s.eyebrow_color }};
    --ts-heading: {{ s.heading_color }};
    --ts-sub: {{ s.subheading_color }};
    --ts-quote: {{ s.quote_color }};
    --ts-title: {{ s.title_color }};
    --ts-name: {{ s.name_color }};
    --ts-meta: {{ s.meta_color }};
    --ts-star: {{ s.star_color }};
    --ts-star-empty: {{ s.star_empty_color }};
    --ts-quote-icon: {{ s.quote_icon_color }};
    --ts-card-bg: {{ card_bg }};
    --ts-card-border: {{ s.card_border_color }};
    --ts-avatar-bg: {{ s.avatar_bg }};
    --ts-avatar-text: {{ s.avatar_text_color }};
    --ts-verified: {{ s.verified_color }};
    --ts-accent-1: {{ s.accent_1 }};
    --ts-accent-2: {{ s.accent_2 }};
    --ts-nav-bg: {{ s.nav_bg }};
    --ts-nav-icon: {{ s.nav_icon_color }};
    --ts-dot: {{ s.dot_color }};
    --ts-dot-active: {{ s.dot_active_color }};
    --ts-spot: {{ spot_color }};
    --ts-effect: {{ effect_color }};

    --ts-radius: {{ s.radius }}px;
    --ts-border-width: {{ s.border_width }}px;
    --ts-blur: {{ s.glass_blur }}px;
    --ts-border-speed: {{ s.border_speed }}s;
    --ts-max-width: {{ s.max_width }}px;
    --ts-header-gap: {{ s.header_spacing }}px;
    --ts-heading-weight: {{ s.heading_weight }};
    --ts-heading-ls: {{ s.heading_letter_spacing }}px;
    --ts-title-weight: {{ s.title_weight }};
    --ts-name-weight: {{ s.name_weight }};
    --ts-line-height: {{ s.line_height }};
    --ts-avatar-size: {{ s.avatar_size }}px;
    --ts-star-size: {{ s.star_size }}px;
    --ts-quote-icon-size: {{ s.quote_icon_size }}px;
    --ts-clamp: {{ s.line_clamp }};
    --ts-speed: {{ s.marquee_speed }}s;
    --ts-card-w: {{ s.marquee_card_width }}px;
    --ts-stagger: {{ s.stagger }}ms;
    --ts-content-gap: {{ s.content_gap }}px;

    /* Desktop values (overridden for tablet / mobile) */
    --ts-cols: {{ s.columns_desktop }};
    --ts-per-view: {{ s.per_view_desktop }};
    --ts-pt: {{ s.padding_top }}px;
    --ts-pb: {{ s.padding_bottom }}px;
    --ts-side: {{ s.side_padding }}px;
    --ts-gap: {{ s.gap }}px;
    --ts-card-pad: {{ s.card_padding }}px;
    --ts-heading-size: {{ s.heading_size }}px;
    --ts-sub-size: {{ s.subheading_size }}px;
    --ts-quote-size: {{ s.quote_size }}px;
    --ts-title-size: {{ s.title_size }}px;
  }

  /* ---------- Section ---------- */
  #Testimonials-{{ section.id }} {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--ts-bg);
    padding-top: var(--ts-pt);
    padding-bottom: var(--ts-pb);
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
  }

  #Testimonials-{{ section.id }} *,
  #Testimonials-{{ section.id }} *::before,
  #Testimonials-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #Testimonials-{{ section.id }} .ts__inner {
    position: relative;
    z-index: 1;
    max-width: var(--ts-max-width);
    margin: 0 auto;
    padding-left: var(--ts-side);
    padding-right: var(--ts-side);
  }

  #Testimonials-{{ section.id }}.ts--full .ts__inner {
    max-width: none;
  }

  #Testimonials-{{ section.id }}.ts--layout-marquee .ts__inner {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }

  #Testimonials-{{ section.id }}.ts--layout-marquee .ts__header {
    max-width: var(--ts-max-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--ts-side);
    padding-right: var(--ts-side);
  }

  /* ---------- Background effects ---------- */
  #Testimonials-{{ section.id }} .ts__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  #Testimonials-{{ section.id }} .ts__bg--grid {
    background-image:
      linear-gradient(var(--ts-effect) 1px, transparent 1px),
      linear-gradient(90deg, var(--ts-effect) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }

  #Testimonials-{{ section.id }} .ts__bg--dots {
    background-image: radial-gradient(var(--ts-effect) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }

  #Testimonials-{{ section.id }} .ts__bg--glow {
    background:
      radial-gradient(40% 50% at 12% 15%, color-mix(in srgb, var(--ts-accent-1) 35%, transparent), transparent 70%),
      radial-gradient(40% 50% at 88% 85%, color-mix(in srgb, var(--ts-accent-2) 30%, transparent), transparent 70%);
    opacity: calc({{ s.effect_strength }} / 20);
    filter: blur(20px);
  }

  /* ---------- Header ---------- */
  #Testimonials-{{ section.id }} .ts__header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: var(--ts-header-gap);
    text-align: {{ s.heading_align }};
    {% case s.heading_align %}
      {% when 'center' %}align-items: center;
      {% when 'right' %}align-items: flex-end;
      {% else %}align-items: flex-start;
    {% endcase %}
  }

  #Testimonials-{{ section.id }} .ts__eyebrow {
    margin: 0;
    color: var(--ts-eyebrow);
    font-size: {{ s.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #Testimonials-{{ section.id }} .ts__heading {
    margin: 0;
    max-width: 24ch;
    color: var(--ts-heading);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-size: var(--ts-heading-size);
    font-weight: var(--ts-heading-weight);
    letter-spacing: var(--ts-heading-ls);
    line-height: 1.1;
    text-transform: {{ s.heading_transform }};
    text-wrap: balance;
  }

  #Testimonials-{{ section.id }}.ts--highlight-gradient .ts__heading em,
  #Testimonials-{{ section.id }}.ts--highlight-gradient .ts__heading i {
    font-style: normal;
    background: linear-gradient(90deg, var(--ts-accent-1), var(--ts-accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  #Testimonials-{{ section.id }}.ts--highlight-accent .ts__heading em,
  #Testimonials-{{ section.id }}.ts--highlight-accent .ts__heading i {
    font-style: normal;
    color: var(--ts-accent-1);
  }

  #Testimonials-{{ section.id }} .ts__subheading {
    margin: 0;
    max-width: 60ch;
    color: var(--ts-sub);
    font-size: var(--ts-sub-size);
    line-height: 1.5;
  }

  #Testimonials-{{ section.id }} .ts__summary {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 10px;
    margin-top: 4px;
    padding: 8px 16px;
    border: 1px solid var(--ts-card-border);
    border-radius: 999px;
    background: var(--ts-card-bg);
    color: var(--ts-meta);
    font-size: 14px;
  }

  #Testimonials-{{ section.id }} .ts__summary-score {
    color: var(--ts-name);
    font-size: 16px;
    font-weight: 700;
  }

  #Testimonials-{{ section.id }} .ts__stars--summary {
    --ts-star-size: 16px;
  }

  /* ---------- Layout: grid ---------- */
  #Testimonials-{{ section.id }}.ts--layout-grid .ts__list {
    display: grid;
    grid-template-columns: repeat(var(--ts-cols), minmax(0, 1fr));
    gap: var(--ts-gap);
  }

  /* ---------- Layout: masonry ---------- */
  #Testimonials-{{ section.id }}.ts--layout-masonry .ts__list {
    column-count: var(--ts-cols);
    column-gap: var(--ts-gap);
  }

  #Testimonials-{{ section.id }}.ts--layout-masonry .ts__item {
    break-inside: avoid;
    margin-bottom: var(--ts-gap);
  }

  /* ---------- Layout: carousel ---------- */
  #Testimonials-{{ section.id }} .ts__carousel {
    position: relative;
  }

  #Testimonials-{{ section.id }} .ts__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--ts-per-view) - 1) * var(--ts-gap)) / var(--ts-per-view));
    gap: var(--ts-gap);
    margin: -16px 0;
    padding: 16px 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    outline: none;
    -webkit-overflow-scrolling: touch;
  }

  #Testimonials-{{ section.id }} .ts__track::-webkit-scrollbar {
    display: none;
  }

  #Testimonials-{{ section.id }} .ts__track:focus-visible {
    outline: 2px solid var(--ts-accent-1);
    outline-offset: -2px;
  }

  #Testimonials-{{ section.id }} .ts__track .ts__item {
    scroll-snap-align: start;
  }

  #Testimonials-{{ section.id }} .ts__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 28px;
  }

  #Testimonials-{{ section.id }} .ts__arrow {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: {{ s.arrow_size }}px;
    height: {{ s.arrow_size }}px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--ts-card-border);
    border-radius: 50%;
    background: var(--ts-nav-bg);
    color: var(--ts-nav-icon);
    cursor: pointer;
    transition: transform 0.25s ease, opacity 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  #Testimonials-{{ section.id }} .ts__arrow svg {
    width: 45%;
    height: 45%;
  }

  #Testimonials-{{ section.id }} .ts__arrow:hover:not(:disabled) {
    border-color: var(--ts-accent-1);
    transform: scale(1.06);
  }

  #Testimonials-{{ section.id }} .ts__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  #Testimonials-{{ section.id }} .ts__arrow:focus-visible,
  #Testimonials-{{ section.id }} .ts__dot:focus-visible,
  #Testimonials-{{ section.id }} .ts__more:focus-visible,
  #Testimonials-{{ section.id }} .ts__product:focus-visible {
    outline: 2px solid var(--ts-accent-1);
    outline-offset: 2px;
  }

  @media screen and (min-width: 990px) {
    #Testimonials-{{ section.id }}.ts--arrows-sides .ts__arrow {
      position: absolute;
      top: 50%;
      z-index: 3;
      transform: translateY(-50%);
      box-shadow: 0 8px 24px rgba(16, 16, 32, 0.12);
    }

    #Testimonials-{{ section.id }}.ts--arrows-sides .ts__arrow:hover:not(:disabled) {
      transform: translateY(-50%) scale(1.06);
    }

    #Testimonials-{{ section.id }}.ts--arrows-sides .ts__arrow--prev {
      left: calc({{ s.arrow_size }}px / -2);
    }

    #Testimonials-{{ section.id }}.ts--arrows-sides .ts__arrow--next {
      right: calc({{ s.arrow_size }}px / -2);
    }

    #Testimonials-{{ section.id }}.ts--arrows-sides .ts__arrow:disabled {
      opacity: 0;
      pointer-events: none;
    }
  }

  #Testimonials-{{ section.id }} .ts__nav[hidden],
  #Testimonials-{{ section.id }} .ts__dots[hidden] {
    display: none;
  }

  #Testimonials-{{ section.id }} .ts__dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #Testimonials-{{ section.id }} .ts__dot {
    width: 8px;
    height: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--ts-dot);
    cursor: pointer;
    transition: width 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.35s ease;
  }

  #Testimonials-{{ section.id }} .ts__dot.is-active {
    width: 26px;
    background: var(--ts-dot-active);
  }

  /* ---------- Layout: marquee ---------- */
  #Testimonials-{{ section.id }} .ts__marquee {
    display: flex;
    flex-direction: column;
    gap: var(--ts-gap);
  }

  #Testimonials-{{ section.id }}.ts--fade .ts__marquee {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 {{ s.marquee_fade_width }}%, #000 {{ 100 | minus: s.marquee_fade_width }}%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 {{ s.marquee_fade_width }}%, #000 {{ 100 | minus: s.marquee_fade_width }}%, transparent);
  }

  #Testimonials-{{ section.id }} .ts__marquee-row {
    overflow: hidden;
    padding: 12px 0;
    margin: -12px 0;
  }

  #Testimonials-{{ section.id }} .ts__marquee-track {
    display: flex;
    width: max-content;
    animation: ts-marquee var(--ts-speed) linear infinite;
    will-change: transform;
  }

  #Testimonials-{{ section.id }} .ts__marquee-row--reverse .ts__marquee-track {
    animation-direction: reverse;
  }

  {% if s.marquee_direction == 'right' %}
    #Testimonials-{{ section.id }} .ts__marquee-track {
      animation-direction: reverse;
    }

    #Testimonials-{{ section.id }} .ts__marquee-row--reverse .ts__marquee-track {
      animation-direction: normal;
    }
  {% endif %}

  #Testimonials-{{ section.id }}.ts--pause .ts__marquee-row:hover .ts__marquee-track,
  #Testimonials-{{ section.id }}.ts--pause .ts__marquee-row:focus-within .ts__marquee-track {
    animation-play-state: paused;
  }

  #Testimonials-{{ section.id }} .ts__marquee-set {
    display: flex;
    align-items: stretch;
  }

  #Testimonials-{{ section.id }} .ts__marquee-set .ts__item {
    flex: 0 0 var(--ts-card-w);
    width: var(--ts-card-w);
    margin-right: var(--ts-gap);
  }

  @keyframes ts-marquee {
    to { transform: translate3d(var(--ts-shift), 0, 0); }
  }

  /* ---------- Card ---------- */
  #Testimonials-{{ section.id }} .ts__item {
    display: flex;
    min-width: 0;
  }

  #Testimonials-{{ section.id }} .ts__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--ts-content-gap);
    width: 100%;
    margin: 0;
    padding: var(--ts-card-pad);
    border-radius: var(--ts-radius);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.3s ease;
  }

  #Testimonials-{{ section.id }}.ts--align-center .ts__card {
    align-items: center;
    text-align: center;
  }

  #Testimonials-{{ section.id }}.ts--style-solid .ts__card {
    background: var(--ts-card-bg);
    border: var(--ts-border-width) solid var(--ts-card-border);
  }

  #Testimonials-{{ section.id }}.ts--style-outline .ts__card {
    background: transparent;
    border: max(var(--ts-border-width), 1px) solid var(--ts-card-border);
  }

  #Testimonials-{{ section.id }}.ts--style-glass .ts__card {
    background: var(--ts-card-bg);
    border: var(--ts-border-width) solid var(--ts-card-border);
    -webkit-backdrop-filter: blur(var(--ts-blur)) saturate(140%);
    backdrop-filter: blur(var(--ts-blur)) saturate(140%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  #Testimonials-{{ section.id }}.ts--style-gradient .ts__card {
    background: var(--ts-card-bg);
    border: 0;
  }

  #Testimonials-{{ section.id }}.ts--style-gradient .ts__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: max(var(--ts-border-width), 1px);
    border-radius: inherit;
    background: conic-gradient(
      from var(--ts-angle),
      var(--ts-accent-1),
      var(--ts-accent-2),
      color-mix(in srgb, var(--ts-accent-1) 15%, transparent),
      var(--ts-accent-1)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  #Testimonials-{{ section.id }}.ts--style-gradient.ts--spin .ts__card::before {
    animation: ts-border-spin var(--ts-border-speed) linear infinite;
  }

  @keyframes ts-border-spin {
    to { --ts-angle: 360deg; }
  }

  #Testimonials-{{ section.id }}.ts--style-minimal .ts__card {
    padding-left: 0;
    padding-right: 0;
    background: transparent;
    border: 0;
    box-shadow: none !important;
  }

  /* Shadows */
  #Testimonials-{{ section.id }}.ts--shadow-soft .ts__card {
    box-shadow: 0 1px 2px rgba(16, 16, 32, 0.04), 0 8px 24px rgba(16, 16, 32, 0.06);
  }

  #Testimonials-{{ section.id }}.ts--shadow-medium .ts__card {
    box-shadow: 0 2px 6px rgba(16, 16, 32, 0.06), 0 16px 40px rgba(16, 16, 32, 0.10);
  }

  #Testimonials-{{ section.id }}.ts--shadow-glow .ts__card {
    box-shadow: 0 10px 40px color-mix(in srgb, var(--ts-accent-1) 24%, transparent);
  }

  /* Spotlight */
  #Testimonials-{{ section.id }}.ts--spotlight .ts__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      300px circle at var(--ts-mx, 50%) var(--ts-my, 50%),
      var(--ts-spot),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  #Testimonials-{{ section.id }}.ts--spotlight .ts__card:hover::after {
    opacity: 1;
  }

  @media (hover: hover) {
    #Testimonials-{{ section.id }}.ts--hover-lift .ts__card:hover {
      transform: translateY(-6px);
    }

    #Testimonials-{{ section.id }}.ts--hover-lift:not(.ts--style-minimal) .ts__card:hover {
      box-shadow: 0 4px 10px rgba(16, 16, 32, 0.06), 0 24px 50px rgba(16, 16, 32, 0.14);
    }

    #Testimonials-{{ section.id }}.ts--hover-glow:not(.ts--style-minimal) .ts__card:hover {
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--ts-accent-1) 40%, transparent),
        0 14px 44px color-mix(in srgb, var(--ts-accent-1) 30%, transparent);
    }

    #Testimonials-{{ section.id }}.ts--hover-border .ts__card:hover {
      border-color: var(--ts-accent-1);
    }
  }

  /* Quote icon */
  #Testimonials-{{ section.id }} .ts__quote-icon {
    flex-shrink: 0;
    width: var(--ts-quote-icon-size);
    height: var(--ts-quote-icon-size);
    color: var(--ts-quote-icon);
  }

  #Testimonials-{{ section.id }}.ts--quote-watermark .ts__quote-icon {
    position: absolute;
    top: calc(var(--ts-card-pad) * 0.6);
    right: calc(var(--ts-card-pad) * 0.6);
    z-index: 0;
    width: calc(var(--ts-quote-icon-size) * 2.4);
    height: calc(var(--ts-quote-icon-size) * 2.4);
    opacity: 0.14;
  }

  #Testimonials-{{ section.id }}.ts--quote-watermark.ts--align-center .ts__quote-icon {
    right: 50%;
    transform: translateX(50%);
  }

  #Testimonials-{{ section.id }} .ts__card > :not(.ts__quote-icon) {
    position: relative;
    z-index: 1;
  }

  /* Stars */
  #Testimonials-{{ section.id }} .ts__stars {
    display: inline-flex;
    gap: 2px;
  }

  #Testimonials-{{ section.id }} .ts__star {
    width: var(--ts-star-size);
    height: var(--ts-star-size);
    fill: var(--ts-star);
  }

  #Testimonials-{{ section.id }} .ts__star.is-empty {
    fill: var(--ts-star-empty);
  }

  /* Text */
  #Testimonials-{{ section.id }} .ts__title {
    margin: 0;
    color: var(--ts-title);
    font-size: var(--ts-title-size);
    font-weight: var(--ts-title-weight);
    line-height: 1.3;
  }

  #Testimonials-{{ section.id }} .ts__quote {
    margin: 0;
    padding: 0;
    border: 0;
    flex: 1 1 auto;
  }

  #Testimonials-{{ section.id }} .ts__quote-text {
    margin: 0;
    color: var(--ts-quote);
    font-size: var(--ts-quote-size);
    {% if s.quote_italic %}font-style: italic;{% endif %}
    line-height: var(--ts-line-height);
  }

  {% if s.line_clamp > 0 %}
    #Testimonials-{{ section.id }} .ts__quote-text {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: var(--ts-clamp);
    }

    #Testimonials-{{ section.id }} .ts__card.is-expanded .ts__quote-text {
      display: block;
      -webkit-line-clamp: unset;
    }
  {% endif %}

  #Testimonials-{{ section.id }} .ts__more {
    align-self: flex-start;
    margin: calc(var(--ts-content-gap) * -0.6) 0 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ts-accent-1);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  #Testimonials-{{ section.id }}.ts--align-center .ts__more {
    align-self: center;
  }

  #Testimonials-{{ section.id }} .ts__more[hidden] {
    display: none;
  }

  /* Review photo */
  #Testimonials-{{ section.id }} .ts__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: {{ s.photo_ratio }};
    object-fit: cover;
    border-radius: calc(var(--ts-radius) * 0.6);
  }

  /* Product chip */
  #Testimonials-{{ section.id }} .ts__product {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    padding: 6px 14px 6px 6px;
    border: 1px solid var(--ts-card-border);
    border-radius: 12px;
    color: var(--ts-name);
    text-align: left;
    text-decoration: none;
    transition: border-color 0.25s ease;
  }

  #Testimonials-{{ section.id }} .ts__product:hover {
    border-color: var(--ts-accent-1);
  }

  #Testimonials-{{ section.id }} .ts__product-img {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 8px;
  }

  #Testimonials-{{ section.id }} .ts__product-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
  }

  #Testimonials-{{ section.id }} .ts__product-label {
    color: var(--ts-meta);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  #Testimonials-{{ section.id }} .ts__product-title {
    overflow: hidden;
    font-size: 14px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Author */
  #Testimonials-{{ section.id }} .ts__author {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
  }

  #Testimonials-{{ section.id }}.ts--align-center .ts__author {
    flex-direction: column;
    gap: 10px;
    text-align: center;
  }

  #Testimonials-{{ section.id }} .ts__avatar {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--ts-avatar-size);
    height: var(--ts-avatar-size);
    object-fit: cover;
    background: var(--ts-avatar-bg);
    color: var(--ts-avatar-text);
    font-size: calc(var(--ts-avatar-size) * 0.38);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  #Testimonials-{{ section.id }}.ts--avatar-circle .ts__avatar { border-radius: 50%; }
  #Testimonials-{{ section.id }}.ts--avatar-rounded .ts__avatar { border-radius: calc(var(--ts-avatar-size) * 0.28); }
  #Testimonials-{{ section.id }}.ts--avatar-square .ts__avatar { border-radius: 4px; }

  #Testimonials-{{ section.id }} .ts__avatar--initials {
    {% if s.avatar_gradient %}
      background: linear-gradient(135deg, var(--ts-accent-1), var(--ts-accent-2));
    {% endif %}
  }

  #Testimonials-{{ section.id }} .ts__author-text {
    min-width: 0;
  }

  #Testimonials-{{ section.id }} .ts__name {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 0;
    color: var(--ts-name);
    font-size: {{ s.name_size }}px;
    font-weight: var(--ts-name-weight);
    line-height: 1.3;
  }

  #Testimonials-{{ section.id }} .ts__verified-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--ts-verified);
  }

  #Testimonials-{{ section.id }} .ts__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 8px;
    margin: 2px 0 0;
    color: var(--ts-meta);
    font-size: {{ s.meta_size }}px;
    line-height: 1.4;
  }

  #Testimonials-{{ section.id }}.ts--align-center .ts__meta {
    justify-content: center;
  }

  #Testimonials-{{ section.id }} .ts__meta > span + span::before {
    content: '·';
    margin-right: 8px;
    opacity: 0.7;
  }

  #Testimonials-{{ section.id }} .ts__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ts-verified);
    font-weight: 600;
  }

  #Testimonials-{{ section.id }} .ts__verified svg {
    width: 13px;
    height: 13px;
  }

  /* ---------- Entrance animation ---------- */
  #Testimonials-{{ section.id }}.ts--js .ts__header,
  #Testimonials-{{ section.id }}.ts--js .ts__marquee,
  #Testimonials-{{ section.id }}.ts--js .ts__list .ts__item,
  #Testimonials-{{ section.id }}.ts--js .ts__track .ts__item {
    opacity: 0;
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #Testimonials-{{ section.id }}.ts--js .ts__list .ts__item,
  #Testimonials-{{ section.id }}.ts--js .ts__track .ts__item {
    transition-delay: calc(min(var(--ts-i, 0), 8) * var(--ts-stagger));
  }

  #Testimonials-{{ section.id }}.ts--js.ts--entrance-fade_up .ts__header,
  #Testimonials-{{ section.id }}.ts--js.ts--entrance-fade_up .ts__marquee,
  #Testimonials-{{ section.id }}.ts--js.ts--entrance-fade_up .ts__list .ts__item,
  #Testimonials-{{ section.id }}.ts--js.ts--entrance-fade_up .ts__track .ts__item {
    transform: translateY(28px);
  }

  #Testimonials-{{ section.id }}.ts--js.ts--entrance-blur .ts__header,
  #Testimonials-{{ section.id }}.ts--js.ts--entrance-blur .ts__marquee,
  #Testimonials-{{ section.id }}.ts--js.ts--entrance-blur .ts__list .ts__item,
  #Testimonials-{{ section.id }}.ts--js.ts--entrance-blur .ts__track .ts__item {
    filter: blur(10px);
    transform: translateY(12px);
  }

  #Testimonials-{{ section.id }}.ts--js .ts__header.is-visible,
  #Testimonials-{{ section.id }}.ts--js .ts__marquee.is-visible,
  #Testimonials-{{ section.id }}.ts--js .ts__list.is-visible .ts__item,
  #Testimonials-{{ section.id }}.ts--js .ts__carousel.is-visible .ts__item {
    opacity: 1;
    transform: none;
    filter: none;
  }

  #Testimonials-{{ section.id }}.ts--js .is-done .ts__item {
    transition: none;
  }

  /* ---------- Tablet ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #Testimonials-{{ section.id }} {
      --ts-cols: {{ s.columns_tablet }};
      --ts-per-view: {{ s.per_view_tablet }};
    }
  }

  /* ---------- Mobile ---------- */
  @media screen and (max-width: 749px) {
    #Testimonials-{{ section.id }} {
      --ts-cols: {{ s.columns_mobile }};
      --ts-per-view: {{ s.per_view_mobile }};
      --ts-pt: {{ s.padding_top_mobile }}px;
      --ts-pb: {{ s.padding_bottom_mobile }}px;
      --ts-side: {{ s.side_padding_mobile }}px;
      --ts-gap: {{ s.gap_mobile }}px;
      --ts-card-pad: {{ s.card_padding_mobile }}px;
      --ts-heading-size: {{ s.heading_size_mobile }}px;
      --ts-sub-size: {{ s.subheading_size_mobile }}px;
      --ts-quote-size: {{ s.quote_size_mobile }}px;
      --ts-title-size: {{ s.title_size_mobile }}px;
      --ts-card-w: {{ s.marquee_card_width_mobile }}px;
      --ts-header-gap: calc({{ s.header_spacing }}px * 0.75);
    }

    #Testimonials-{{ section.id }} .ts__nav {
      margin-top: 20px;
    }

    #Testimonials-{{ section.id }} .ts__track {
      margin-left: calc(var(--ts-side) * -1);
      margin-right: calc(var(--ts-side) * -1);
      padding-left: var(--ts-side);
      padding-right: var(--ts-side);
      scroll-padding-left: var(--ts-side);
    }
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    #Testimonials-{{ section.id }} *,
    #Testimonials-{{ section.id }} *::before,
    #Testimonials-{{ section.id }} *::after {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }

