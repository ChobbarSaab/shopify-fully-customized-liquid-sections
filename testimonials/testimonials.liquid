<script>
  (function () {
    var root = document.getElementById('Testimonials-{{ section.id }}');

    if (!root) {
      return;
    }

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var inEditor = window.Shopify && window.Shopify.designMode;

    /* ---------- Read more ---------- */
    var moreText = root.getAttribute('data-more') || 'Read more';
    var lessText = root.getAttribute('data-less') || 'Read less';

    function checkClamps() {
      root.querySelectorAll('.ts__card').forEach(function (card) {
        var text = card.querySelector('.ts__quote-text');
        var button = card.querySelector('.ts__more');
        if (!text || !button || card.classList.contains('is-expanded')) {
          return;
        }
        button.hidden = text.scrollHeight <= text.clientHeight + 2;
      });
    }

    root.querySelectorAll('.ts__more').forEach(function (button) {
      button.addEventListener('click', function () {
        var card = button.closest('.ts__card');
        var expanded = card.classList.toggle('is-expanded');
        button.textContent = expanded ? lessText : moreText;
        button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      });
    });

    checkClamps();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(checkClamps);
    }

    /* ---------- Carousel ---------- */
    var track = root.querySelector('.ts__track');
    var autoplayTimer = null;

    if (track) {
      var items = Array.prototype.slice.call(track.querySelectorAll('.ts__item'));
      var prev = root.querySelector('.ts__arrow--prev');
      var next = root.querySelector('.ts__arrow--next');
      var dotsWrap = root.querySelector('.ts__dots');
      var loop = root.getAttribute('data-loop') === 'true';
      var autoplayDelay = parseFloat(root.getAttribute('data-autoplay')) || 0;
      var paused = false;
      var dots = [];

      function stepSize() {
        if (items.length > 1) {
          return items[1].offsetLeft - items[0].offsetLeft;
        }
        return track.clientWidth;
      }

      function maxScroll() {
        return Math.max(0, track.scrollWidth - track.clientWidth);
      }

      function pageCount() {
        var step = stepSize();
        return step > 0 ? Math.round(maxScroll() / step) + 1 : 1;
      }

      function currentIndex() {
        var step = stepSize();
        if (track.scrollLeft >= maxScroll() - 4) {
          return pageCount() - 1;
        }
        return step > 0 ? Math.round(track.scrollLeft / step) : 0;
      }

      function goTo(index) {
        var pages = pageCount();
        if (index < 0) {
          index = loop ? pages - 1 : 0;
        }
        if (index > pages - 1) {
          index = loop ? 0 : pages - 1;
        }
        track.scrollTo({
          left: Math.min(index * stepSize(), maxScroll()),
          behavior: reducedMotion ? 'auto' : 'smooth'
        });
      }

      function buildDots() {
        if (!dotsWrap) {
          return;
        }
        var pages = pageCount();
        dotsWrap.innerHTML = '';
        dots = [];
        dotsWrap.hidden = pages <= 1;
        for (var i = 0; i < pages; i++) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'ts__dot';
          dot.setAttribute('aria-label', (i + 1) + ' / ' + pages);
          (function (target) {
            dot.addEventListener('click', function () {
              goTo(target);
            });
          })(i);
          dotsWrap.appendChild(dot);
          dots.push(dot);
        }
      }

      function update() {
        var index = currentIndex();
        var pages = pageCount();
        dots.forEach(function (dot, i) {
          dot.classList.toggle('is-active', i === index);
          dot.setAttribute('aria-current', i === index ? 'true' : 'false');
        });
        if (prev) {
          prev.disabled = !loop && index <= 0;
        }
        if (next) {
          next.disabled = !loop && index >= pages - 1;
        }
        var nav = root.querySelector('.ts__nav');
        if (nav) {
          nav.hidden = pages <= 1;
        }
      }

      var ticking = false;
      track.addEventListener('scroll', function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(function () {
            update();
            ticking = false;
          });
        }
      }, { passive: true });

      if (prev) {
        prev.addEventListener('click', function () {
          goTo(currentIndex() - 1);
        });
      }

      if (next) {
        next.addEventListener('click', function () {
          goTo(currentIndex() + 1);
        });
      }

      track.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          goTo(currentIndex() + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          goTo(currentIndex() - 1);
        }
      });

      function startAutoplay() {
        clearInterval(autoplayTimer);
        if (!autoplayDelay || reducedMotion) {
          return;
        }
        autoplayTimer = setInterval(function () {
          if (paused || document.hidden) {
            return;
          }
          var index = currentIndex();
          var pages = pageCount();
          goTo(index >= pages - 1 ? 0 : index + 1);
        }, autoplayDelay * 1000);
      }

      ['mouseenter', 'focusin', 'touchstart'].forEach(function (type) {
        root.addEventListener(type, function () {
          paused = true;
        }, { passive: true });
      });

      ['mouseleave', 'focusout'].forEach(function (type) {
        root.addEventListener(type, function () {
          paused = false;
        });
      });

      buildDots();
      update();
      startAutoplay();

      var resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          buildDots();
          update();
          checkClamps();
        }, 150);
      }, { passive: true });

      /* Theme editor: scroll to the testimonial selected in the sidebar */
      document.addEventListener('shopify:block:select', function (event) {
        var index = items.indexOf(event.target);
        if (index !== -1) {
          paused = true;
          track.scrollTo({ left: Math.min(items[index].offsetLeft - items[0].offsetLeft, maxScroll()) });
        }
      });

      document.addEventListener('shopify:block:deselect', function () {
        paused = false;
      });
    } else {
      window.addEventListener('resize', function () {
        clearTimeout(root._tsResize);
        root._tsResize = setTimeout(checkClamps, 150);
      }, { passive: true });
    }

    /* ---------- Cursor spotlight ---------- */
    if (root.classList.contains('ts--spotlight') && window.matchMedia('(hover: hover)').matches) {
      root.addEventListener('pointermove', function (event) {
        var card = event.target.closest && event.target.closest('.ts__card');
        if (!card || !root.contains(card)) {
          return;
        }
        var rect = card.getBoundingClientRect();
        card.style.setProperty('--ts-mx', event.clientX - rect.left + 'px');
        card.style.setProperty('--ts-my', event.clientY - rect.top + 'px');
      }, { passive: true });
    }

    /* ---------- Entrance animation ---------- */
    var entrance = root.getAttribute('data-entrance');

    if (entrance && entrance !== 'none' && !reducedMotion && !inEditor && 'IntersectionObserver' in window) {
      root.classList.add('ts--js');

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) {
            return;
          }
          var el = entry.target;
          el.classList.add('is-visible');
          observer.unobserve(el);
          setTimeout(function () {
            el.classList.add('is-done');
          }, 1600);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

      root.querySelectorAll('.ts__reveal').forEach(function (el) {
        observer.observe(el);
      });
    }

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.target.contains(root)) {
        clearInterval(autoplayTimer);
      }
    });
  })();
</script>

